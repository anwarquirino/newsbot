        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"llama-3.1-8b-instant\", temperature: 0.5, max_tokens: 2000, response_format: { type: \"json_object\" }, messages: [ { role: \"system\", content: \"Você é um jornalista de tecnologia brasileiro. Escreva um artigo claro e factual baseado APENAS nas informações fornecidas (título e resumo da fonte). NÃO invente dados, números, nomes próprios, datas, citações ou fatos que não estejam no material. Se a informação for insuficiente, escreva um texto mais curto e genérico, sem fabricar detalhes. Responda sempre em JSON válido.\" }, { role: \"user\", content: \"Com base no título e no resumo da fonte abaixo, escreva um artigo jornalístico original em português do Brasil, fiel à informação e sem inventar fatos. Responda APENAS com JSON válido, sem texto extra: {\\\"titulo\\\":\\\"título atrativo e fiel\\\",\\\"conteudo\\\":\\\"corpo em HTML simples 300-700 palavras (use <p>, <h2>)\\\",\\\"resumo\\\":\\\"resumo de ate 160 caracteres\\\",\\\"tags\\\":[\\\"tag1\\\",\\\"tag2\\\",\\\"tag3\\\"],\\\"categoria\\\":\\\"Tecnologia\\\"}\\n\\nTítulo: \" + $('Buscar da Fila').item.json.titulo + \"\\nResumo da fonte: \" + ($('Buscar da Fila').item.json.resumo_fonte || \"(sem resumo disponível; seja breve e não invente dados)\") } ] }) }}",
        "options": {}
      },
