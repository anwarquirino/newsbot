    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "function extract(obj){\n  if(obj==null) return null;\n  const cands=[obj, obj.choices&&obj.choices[0]&&obj.choices[0].message&&obj.choices[0].message.content, obj.message&&obj.message.content, obj.content, obj.text];\n  for(let c of cands){\n    if(c==null) continue;\n    if(typeof c==='string'){ try{ c=JSON.parse(c.replace(/```json|```/g,'').trim()); }catch(e){ continue; } }\n    if(c&&typeof c==='object'&&('conteudo' in c||'titulo' in c)) return c;\n  }\n  return null;\n}\nconst art=extract($input.first().json);\nif(!art||!art.titulo){ throw new Error('Nao consegui parsear o artigo retornado pela IA'); }\nconst tags=Array.isArray(art.tags)?art.tags.join(', '):(art.tags||'');\nreturn [{ json: { id: $('Buscar da Fila').item.json.id, artigo: { titulo: art.titulo||'', conteudo: art.conteudo||'', resumo: (art.resumo||'').slice(0,160), categoria: art.categoria||'Tecnologia', tags } } }];"
      },
